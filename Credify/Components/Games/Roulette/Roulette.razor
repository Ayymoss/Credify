@page "/credify/roulette"
@rendermode RenderMode.InteractiveServer
@implements IAsyncDisposable

<PageTitle>Credify · Roulette</PageTitle>

<PluginPageShell BackgroundClass="rl-felt text-zinc-100" Menu='CredifyNav.Build("/credify/roulette")'>

        <!-- header -->
        <GameHeader Title="Roulette" Icon="ph-circle-half" Balance="_balance" Authed="_authed"/>

        <GameHistoryPanel ClientId="_client?.ClientId"/>

        @if (_loading)
        {
            <div class="flex items-center justify-center py-24 text-zinc-400">
                <i class="ph ph-spinner animate-spin text-3xl"></i>
            </div>
        }
        else
        {
            <div class="mt-5 grid gap-6 lg:grid-cols-2">

                <!-- LEFT: wheel + status + history -->
                <div class="flex flex-col items-center gap-4">
                    @if (_snapshot.Phase == "Betting")
                    {
                        <GameCountdown Seconds="_snapshot.SecondsRemaining" Total="BettingWindow" Label="Place your bets"/>
                    }
                    else
                    {
                        <div class="@StatusClass">
                            @switch (_snapshot.Phase)
                            {
                                case "Spinning":
                                    <i class="ph ph-spinner animate-spin"></i>
                                    <span>No more bets — spinning…</span>
                                    break;
                                case "Resolving":
                                    if (_wheelLanding)
                                    {
                                        <i class="ph ph-spinner animate-spin"></i>
                                        <span>No more bets — spinning…</span>
                                    }
                                    else
                                    {
                                        <i class="ph-fill ph-flag-checkered"></i>
                                        <span>Round over</span>
                                    }
                                    break;
                                default:
                                    <i class="ph-fill ph-users"></i>
                                    <span>Waiting for players</span>
                                    break;
                            }
                        </div>
                    }

                    <div @ref="_wheelRef" class="rl-wheel"></div>

                    @if (_snapshot.LastSpin is { } spin && _snapshot.Phase != "Spinning" && !_wheelLanding)
                    {
                        <div class="rl-result">
                            <span class="rl-num-badge @ColourClass(spin.Colour)">@spin.Display</span>
                            <span class="text-zinc-300">@spin.Colour</span>
                            @if (MyView is { Outcome: "Won" } w)
                            {
                                <span class="rl-seat-won">+@w.Net.ToString("N0")</span>
                            }
                            else if (MyView is { Outcome: "Lost" } l)
                            {
                                <span class="rl-seat-lost">@l.Net.ToString("N0")</span>
                            }
                        </div>
                    }

                    @if (_snapshot.History.Count > 0)
                    {
                        <div class="rl-history">
                            @foreach (var h in VisibleHistory)
                            {
                                <span class="rl-num-badge @ColourClass(h.Colour)" title="@h.Colour">@h.Display</span>
                            }
                        </div>
                    }
                </div>

                <!-- RIGHT: bet board / seat + participants -->
                <div class="flex flex-col gap-4">

                    @if (!_authed)
                    {
                        <JoinTablePanel Icon="ph-fill ph-sign-in" Title="Sign in to play"
                                        Description="Watch the table live below. Log into IW4MAdmin to take a seat and bet your credits.">
                            <a href="/" class="credify-join-btn"><i class="ph ph-sign-in"></i> Sign in</a>
                        </JoinTablePanel>
                    }
                    else if (!Seated)
                    {
                        <JoinTablePanel Icon="ph-fill ph-armchair" Title="Join the table"
                                        Description="Take a seat to bet alongside the players in-game. You'll be in for the next round.">
                            <button class="credify-join-btn" disabled="@_busy" @onclick="TakeSeat">
                                <i class="ph-fill ph-armchair"></i> Take a seat
                            </button>
                            @if (_balance < 10)
                            {
                                <p class="text-sm text-rose-400">You need at least 10 credits to play.</p>
                            }
                        </JoinTablePanel>
                    }
                    else
                    {
                        <!-- seated: build a slip of bets, then commit them together -->
                        <div class="rl-panel">
                            <div class="flex items-center justify-between">
                                <h2 class="text-base font-bold">Your bets</h2>
                                <button class="text-xs text-zinc-400 hover:text-zinc-200 hover:underline" @onclick="LeaveSeat">Leave table</button>
                            </div>

                            @if (MyView is { HasBet: true } placed)
                            {
                                <!-- already committed this round -->
                                <div class="rl-placed mt-2">
                                    @foreach (var b in placed.Bets)
                                    {
                                        <span class="rl-placed-chip">@b.Label <span class="text-amber-300">@b.Stake.ToString("N0")</span></span>
                                    }
                                </div>
                                <p class="mt-2 text-sm text-zinc-400">
                                    Total <span class="font-semibold text-amber-300">@placed.TotalStake.ToString("N0")</span> — waiting for the spin.
                                </p>
                            }
                            else
                            {
                                @if (_snapshot.Phase != "Betting")
                                {
                                    <p class="mt-2 text-sm text-zinc-400">Betting opens at the start of the next round.</p>
                                }

                                <!-- stake per chip -->
                                <div class="mt-3">
                                    <BetControl @bind-Value="_stake" Balance="_balance" Disabled="@(!CanBet)" Label="Chip"/>
                                </div>

                                <!-- bet slip -->
                                @if (_pendingBets.Count > 0)
                                {
                                    <div class="rl-slip mt-3">
                                        @for (var i = 0; i < _pendingBets.Count; i++)
                                        {
                                            var idx = i;
                                            <button class="rl-slip-chip" disabled="@_busy" @onclick="() => RemovePending(idx)" title="Remove bet">
                                                @_pendingBets[idx].Label <span class="text-amber-300">@_pendingBets[idx].Stake.ToString("N0")</span> <i class="ph ph-x"></i>
                                            </button>
                                        }
                                    </div>
                                    <div class="mt-2 flex flex-wrap items-center justify-center gap-3">
                                        <span class="text-sm text-zinc-400">Total <span class="text-base font-bold text-amber-300">@PendingTotal.ToString("N0")</span></span>
                                        <button class="rl-btn rl-btn-primary" disabled="@(_busy || !CanBet)" @onclick="PlaceBets">
                                            <i class="ph-fill ph-check"></i> Place @_pendingBets.Count bet@(_pendingBets.Count == 1 ? "" : "s")
                                        </button>
                                        <button class="rl-btn" disabled="@_busy" @onclick="ClearPending">Clear</button>
                                    </div>
                                }
                                else
                                {
                                    <p class="mt-3 text-center text-xs text-zinc-500">Tap the board to add bets, then place them. Mix as many as you like.</p>
                                }

                                <!-- outside bets -->
                                <div class="rl-outside mt-3">
                                    <button class="rl-bet rl-bet-red" disabled="@(!CanAdd)" @onclick='() => AddPending("red", "Red")'>Red</button>
                                    <button class="rl-bet rl-bet-black" disabled="@(!CanAdd)" @onclick='() => AddPending("black", "Black")'>Black</button>
                                    <button class="rl-bet" disabled="@(!CanAdd)" @onclick='() => AddPending("even", "Even")'>Even</button>
                                    <button class="rl-bet" disabled="@(!CanAdd)" @onclick='() => AddPending("odd", "Odd")'>Odd</button>
                                    <button class="rl-bet" disabled="@(!CanAdd)" @onclick='() => AddPending("low", "1–18")'>1–18</button>
                                    <button class="rl-bet" disabled="@(!CanAdd)" @onclick='() => AddPending("high", "19–36")'>19–36</button>
                                    <button class="rl-bet" disabled="@(!CanAdd)" @onclick='() => AddPending("d1", "1st 12")'>1st 12</button>
                                    <button class="rl-bet" disabled="@(!CanAdd)" @onclick='() => AddPending("d2", "2nd 12")'>2nd 12</button>
                                    <button class="rl-bet" disabled="@(!CanAdd)" @onclick='() => AddPending("d3", "3rd 12")'>3rd 12</button>
                                    <button class="rl-bet" disabled="@(!CanAdd)" @onclick='() => AddPending("c1", "Col 1")'>Col 1</button>
                                    <button class="rl-bet" disabled="@(!CanAdd)" @onclick='() => AddPending("c2", "Col 2")'>Col 2</button>
                                    <button class="rl-bet" disabled="@(!CanAdd)" @onclick='() => AddPending("c3", "Col 3")'>Col 3</button>
                                </div>

                                <!-- straight-up numbers -->
                                <p class="mt-3 mb-1 text-xs uppercase tracking-wide text-zinc-500">Straight up (36×)</p>
                                <div class="rl-zero-row mb-1">
                                    <button class="rl-cell rl-green" disabled="@(!CanAdd)" @onclick='() => AddPending("0", "0")'>0</button>
                                    <button class="rl-cell rl-green" disabled="@(!CanAdd)" @onclick='() => AddPending("00", "00")'>00</button>
                                </div>
                                <div class="rl-grid">
                                    @for (var n = 1; n <= 36; n++)
                                    {
                                        var num = n;
                                        <button class="rl-cell @(IsRed(num) ? "rl-red" : "rl-black")"
                                                disabled="@(!CanAdd)" @onclick="() => AddPending(num.ToString(), num.ToString())">@num</button>
                                    }
                                </div>
                            }

                            @if (_error is not null)
                            {
                                <div class="rl-toast mt-3">@_error</div>
                            }
                        </div>
                    }

                    <!-- participants (web + in-game, shared table) -->
                    <div class="rl-panel">
                        <h2 class="flex items-center gap-2 text-base font-bold">
                            <i class="ph-fill ph-users-three text-[color:var(--color-action-primary,#818cf8)]"></i>
                            At the table <span class="rl-muted text-sm font-normal">(@_snapshot.Players.Count)</span>
                        </h2>
                        @if (_snapshot.Players.Count == 0)
                        {
                            <p class="mt-2 text-sm text-zinc-400">No one seated yet. Be the first.</p>
                        }
                        else
                        {
                            <div class="rl-seats mt-3">
                                @foreach (var p in _snapshot.Players)
                                {
                                    <div class="rl-seat @(IsMe(p) ? "rl-seat-you" : "")">
                                        <span class="flex items-center gap-2 truncate">
                                            <i class="ph-fill ph-user text-zinc-400"></i>
                                            <span class="truncate">@p.Name</span>
                                            @if (IsMe(p))
                                            {
                                                <span class="rl-muted text-xs">you</span>
                                            }
                                        </span>
                                        <span class="text-right">
                                            @if (p.HasBet)
                                            {
                                                <span class="rl-seat-bet">@p.TotalStake.ToString("N0") · @p.Bets.Count bet@(p.Bets.Count == 1 ? "" : "s")</span>
                                            }
                                            else if (p.Outcome == "Won" && !_wheelLanding)
                                            {
                                                <span class="rl-seat-won">+@p.Net.ToString("N0")</span>
                                            }
                                            else if (p.Outcome == "Lost" && !_wheelLanding)
                                            {
                                                <span class="rl-seat-lost">@p.Net.ToString("N0")</span>
                                            }
                                            else
                                            {
                                                <span class="rl-muted text-xs">—</span>
                                            }
                                        </span>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <div class="text-center">
                        <a href="/credify" class="text-sm text-zinc-400 hover:text-zinc-200 hover:underline">← Back to Credify</a>
                    </div>
                </div>
            </div>
        }
</PluginPageShell>

