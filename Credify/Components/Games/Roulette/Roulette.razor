@page "/credify/roulette"
@rendermode RenderMode.InteractiveServer
@implements IAsyncDisposable

<PageTitle>Credify · Roulette</PageTitle>
@* one HeadContent only — HeadContent is last-render-wins *@
<HeadContent>
    <link rel="stylesheet" href="/_content/credify/plugin.css"/>
    <link rel="stylesheet" href="/_content/credify/custom.css"/>
    <link rel="stylesheet" href="/_content/credify/roulette/roulette.css"/>
</HeadContent>

<PluginPageShell FeltClass="rl-felt text-zinc-100" Menu='CredifyNav.Build("/credify/roulette")'>

        <!-- header -->
        <div class="flex items-center justify-between gap-3">
            <div class="flex items-center gap-2">
                <i class="ph-fill ph-circle-half text-2xl text-[color:var(--color-action-primary,#818cf8)]"></i>
                <h1 class="text-2xl font-bold tracking-tight">Roulette</h1>
            </div>
            <div class="flex items-center gap-2">
                <CredifyAudioControls/>
                <span class="rl-chip-stat"><i class="ph-fill ph-coins text-amber-400"></i> @Cache.BankCredits.ToString("N0") <span class="rl-muted">bank</span></span>
                @if (_authed)
                {
                    <span class="rl-chip-stat"><i class="ph-fill ph-wallet text-emerald-400"></i> @_balance.ToString("N0") <span class="rl-muted">credits</span></span>
                }
            </div>
        </div>

        @if (_loading)
        {
            <div class="flex items-center justify-center py-24 text-zinc-400">
                <i class="ph ph-spinner animate-spin text-3xl"></i>
            </div>
        }
        else
        {
            <div class="mt-5 grid gap-6 lg:grid-cols-2">

                <!-- LEFT: wheel + status + history -->
                <div class="flex flex-col items-center gap-4">
                    <div class="@StatusClass">
                        @switch (_snapshot.Phase)
                        {
                            case "Betting":
                                <i class="ph-fill ph-timer"></i>
                                <span>Place your bets</span>
                                <span class="rl-countdown">@($"{_snapshot.SecondsRemaining:0}s")</span>
                                break;
                            case "Spinning":
                                <i class="ph ph-spinner animate-spin"></i>
                                <span>No more bets — spinning…</span>
                                break;
                            case "Resolving":
                                <i class="ph-fill ph-flag-checkered"></i>
                                <span>Round over</span>
                                break;
                            default:
                                <i class="ph-fill ph-users"></i>
                                <span>Waiting for players</span>
                                break;
                        }
                    </div>

                    @if (_snapshot.Phase == "Betting")
                    {
                        <div class="w-48 rl-countbar">
                            <div class="rl-countbar-fill" style="width:@(BettingBarPct)%"></div>
                        </div>
                    }

                    <div @ref="_wheelRef" class="rl-wheel"></div>

                    @if (_snapshot.LastSpin is { } spin && _snapshot.Phase != "Spinning")
                    {
                        <div class="rl-result">
                            <span class="rl-num-badge @ColourClass(spin.Colour)">@spin.Display</span>
                            <span class="text-zinc-300">@spin.Colour</span>
                            @if (MyView is { Outcome: "Won" } w)
                            {
                                <span class="rl-seat-won">+@w.Net.ToString("N0")</span>
                            }
                            else if (MyView is { Outcome: "Lost" } l)
                            {
                                <span class="rl-seat-lost">@l.Net.ToString("N0")</span>
                            }
                        </div>
                    }

                    @if (_snapshot.History.Count > 0)
                    {
                        <div class="rl-history">
                            @foreach (var h in _snapshot.History)
                            {
                                <span class="rl-num-badge @ColourClass(h.Colour)" title="@h.Colour">@h.Display</span>
                            }
                        </div>
                    }
                </div>

                <!-- RIGHT: bet board / seat + participants -->
                <div class="flex flex-col gap-4">

                    @if (!_authed)
                    {
                        <div class="rl-panel text-center">
                            <i class="ph-fill ph-sign-in text-4xl text-[color:var(--color-action-primary,#818cf8)]"></i>
                            <h2 class="mt-2 text-lg font-bold">Sign in to play</h2>
                            <p class="mt-1 text-sm text-zinc-400">Watch the table live below. Log into IW4MAdmin to take a seat and bet your credits.</p>
                        </div>
                    }
                    else if (!Seated)
                    {
                        <div class="rl-panel text-center">
                            <h2 class="text-lg font-bold">Join the table</h2>
                            <p class="mt-1 text-sm text-zinc-400">Take a seat to bet alongside the players in-game. You'll be in for the next round.</p>
                            <button class="rl-btn rl-btn-primary mt-3 inline-flex" disabled="@_busy" @onclick="TakeSeat">
                                <i class="ph-fill ph-armchair"></i> Take a seat
                            </button>
                            @if (_balance < 10)
                            {
                                <p class="mt-2 text-sm text-rose-400">You need at least 10 credits to play.</p>
                            }
                        </div>
                    }
                    else
                    {
                        <!-- seated: stake + board (active only during betting & before I've bet) -->
                        <div class="rl-panel">
                            @{
                                var canBet = _snapshot.Phase == "Betting" && MyView is not null && !MyView.HasBet && !_busy;
                            }
                            <div class="flex items-center justify-between">
                                <h2 class="text-base font-bold">Your bet</h2>
                                <button class="text-xs text-zinc-400 hover:text-zinc-200 hover:underline" @onclick="LeaveSeat">Leave table</button>
                            </div>

                            @if (MyView is { HasBet: true })
                            {
                                <p class="mt-2 text-sm">
                                    <span class="text-zinc-400">Placed:</span>
                                    <span class="font-semibold text-amber-300">@MyView.Stake.ToString("N0")</span>
                                    on <span class="font-semibold">@MyView.BetLabel</span> — waiting for the spin.
                                </p>
                            }
                            else if (_snapshot.Phase != "Betting")
                            {
                                <p class="mt-2 text-sm text-zinc-400">Betting opens at the start of the next round.</p>
                            }

                            <!-- stake chips -->
                            <div class="mt-3 flex flex-wrap items-center gap-2">
                                @foreach (var chip in _chips)
                                {
                                    <button class="rl-chip @(_stake == chip ? "rl-chip-on" : "")"
                                            disabled="@(_busy || chip > _balance)" @onclick="() => _stake = chip">@chip.ToString("N0")</button>
                                }
                                <span class="text-sm text-zinc-400">Stake <span class="text-base font-bold text-amber-300">@_stake.ToString("N0")</span></span>
                            </div>

                            <!-- outside bets -->
                            <div class="rl-outside mt-3">
                                <button class="rl-bet rl-bet-red" disabled="@(!canBet)" @onclick='() => PlaceBet("red")'>Red</button>
                                <button class="rl-bet rl-bet-black" disabled="@(!canBet)" @onclick='() => PlaceBet("black")'>Black</button>
                                <button class="rl-bet" disabled="@(!canBet)" @onclick='() => PlaceBet("even")'>Even</button>
                                <button class="rl-bet" disabled="@(!canBet)" @onclick='() => PlaceBet("odd")'>Odd</button>
                                <button class="rl-bet" disabled="@(!canBet)" @onclick='() => PlaceBet("low")'>1–18</button>
                                <button class="rl-bet" disabled="@(!canBet)" @onclick='() => PlaceBet("high")'>19–36</button>
                                <button class="rl-bet" disabled="@(!canBet)" @onclick='() => PlaceBet("d1")'>1st 12</button>
                                <button class="rl-bet" disabled="@(!canBet)" @onclick='() => PlaceBet("d2")'>2nd 12</button>
                                <button class="rl-bet" disabled="@(!canBet)" @onclick='() => PlaceBet("d3")'>3rd 12</button>
                                <button class="rl-bet" disabled="@(!canBet)" @onclick='() => PlaceBet("c1")'>Col 1</button>
                                <button class="rl-bet" disabled="@(!canBet)" @onclick='() => PlaceBet("c2")'>Col 2</button>
                                <button class="rl-bet" disabled="@(!canBet)" @onclick='() => PlaceBet("c3")'>Col 3</button>
                            </div>

                            <!-- straight-up numbers -->
                            <p class="mt-3 mb-1 text-xs uppercase tracking-wide text-zinc-500">Straight up (36×)</p>
                            <div class="rl-zero-row mb-1">
                                <button class="rl-cell rl-green" disabled="@(!canBet)" @onclick='() => PlaceBet("0")'>0</button>
                                <button class="rl-cell rl-green" disabled="@(!canBet)" @onclick='() => PlaceBet("00")'>00</button>
                            </div>
                            <div class="rl-grid">
                                @for (var n = 1; n <= 36; n++)
                                {
                                    var num = n;
                                    <button class="rl-cell @(IsRed(num) ? "rl-red" : "rl-black")"
                                            disabled="@(!canBet)" @onclick="() => PlaceBet(num.ToString())">@num</button>
                                }
                            </div>

                            @if (_error is not null)
                            {
                                <div class="rl-toast mt-3">@_error</div>
                            }
                        </div>
                    }

                    <!-- participants (web + in-game, shared table) -->
                    <div class="rl-panel">
                        <h2 class="flex items-center gap-2 text-base font-bold">
                            <i class="ph-fill ph-users-three text-[color:var(--color-action-primary,#818cf8)]"></i>
                            At the table <span class="rl-muted text-sm font-normal">(@_snapshot.Players.Count)</span>
                        </h2>
                        @if (_snapshot.Players.Count == 0)
                        {
                            <p class="mt-2 text-sm text-zinc-400">No one seated yet. Be the first.</p>
                        }
                        else
                        {
                            <div class="rl-seats mt-3">
                                @foreach (var p in _snapshot.Players)
                                {
                                    <div class="rl-seat @(IsMe(p) ? "rl-seat-you" : "")">
                                        <span class="flex items-center gap-2 truncate">
                                            <i class="ph-fill ph-user text-zinc-400"></i>
                                            <span class="truncate">@p.Name</span>
                                            @if (IsMe(p))
                                            {
                                                <span class="rl-muted text-xs">you</span>
                                            }
                                        </span>
                                        <span class="text-right">
                                            @if (p.HasBet)
                                            {
                                                <span class="rl-seat-bet">@p.Stake.ToString("N0") · @p.BetLabel</span>
                                            }
                                            else if (p.Outcome == "Won")
                                            {
                                                <span class="rl-seat-won">+@p.Net.ToString("N0")</span>
                                            }
                                            else if (p.Outcome == "Lost")
                                            {
                                                <span class="rl-seat-lost">@p.Net.ToString("N0")</span>
                                            }
                                            else
                                            {
                                                <span class="rl-muted text-xs">—</span>
                                            }
                                        </span>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <div class="text-center">
                        <a href="/credify" class="text-sm text-zinc-400 hover:text-zinc-200 hover:underline">← Back to Credify</a>
                    </div>
                </div>
            </div>
        }
</PluginPageShell>

