@page "/credify/plinko"
@rendermode RenderMode.InteractiveServer
@implements IAsyncDisposable
@using Credify.Games.Plinko

<PageTitle>Credify · Plinko</PageTitle>

<PluginPageShell BackgroundClass="pl-felt text-zinc-100" Menu='CredifyNav.Build("/credify/plinko")'>

    <!-- header -->
    <GameHeader Title="Plinko" Icon="ph-circles-three" Balance="DisplayBalance" Authed="_authed"/>

    <GameHistoryPanel ClientId="_client?.ClientId"/>

    @if (_loading)
    {
        <div class="flex items-center justify-center py-24 text-zinc-400">
            <i class="ph ph-spinner animate-spin text-3xl"></i>
        </div>
    }
    else if (!_authed)
    {
        <!-- anonymous: how-to + leaderboard -->
        <div class="mt-6 grid gap-6 md:grid-cols-2">
            <div class="pl-panel text-center">
                <i class="ph-fill ph-circles-three text-5xl text-[color:var(--color-action-primary,#818cf8)]"></i>
                <h2 class="mt-3 text-xl font-bold">Sign in to play</h2>
                <p class="mt-1 text-sm text-zinc-400">
                    Drop a ball through the pegs and watch it bounce into a multiplier. The rare outer
                    buckets pay the biggest — pick your risk and let it fall.
                </p>
                <a href="/" class="pl-btn pl-btn-primary mt-4 inline-flex"><i class="ph ph-sign-in"></i> Sign in</a>
            </div>
            <div class="pl-panel">
                <h2 class="flex items-center gap-2 text-lg font-bold"><i class="ph-fill ph-trophy text-amber-400"></i> Top credits</h2>
                @if (Cache.TopCredits.Count == 0)
                {
                    <p class="mt-3 text-sm text-zinc-400">No credit data yet.</p>
                }
                else
                {
                    <ol class="mt-3 space-y-1">
                        @foreach (var (entry, i) in Cache.TopCredits.Take(10).Select((e, i) => (e, i)))
                        {
                            <li class="flex items-center justify-between rounded-md bg-black/20 px-3 py-1.5 text-sm">
                                <span class="flex items-center gap-2"><span class="w-5 text-right text-zinc-500">@(i + 1)</span> Client @entry.ClientId</span>
                                <span class="font-semibold">@entry.Credits.ToString("N0")</span>
                            </li>
                        }
                    </ol>
                }
            </div>
        </div>
    }
    else
    {
        <GameResultToast Toast="_toast"/>

        <!-- the board: JS-owned canvas (pegs + ball) above the multiplier bucket strip -->
        <div class="pl-board pl-risk-@RiskKey(_risk) mt-5">
            <canvas @ref="_canvasRef" class="pl-canvas"></canvas>
            <div class="pl-buckets" style="grid-template-columns:repeat(@(_multipliers.Count), minmax(0, 1fr));">
                @for (var i = 0; i < _multipliers.Count; i++)
                {
                    var hits = _bucketHits.GetValueOrDefault(i);
                    var landed = hits > 0 && _dropsInFlight == 0;
                    <div class="pl-bucket @BucketClass(_multipliers[i]) @(landed ? "pl-bucket-landed" : "")" title="@BucketTooltip(i)">
                        @BucketLabel(_multipliers[i])
                        @if (landed && hits > 1)
                        {
                            <span class="pl-bucket-count">@hits</span>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- controls -->
        <div class="pl-controls mt-5">
            <!-- risk + rows + balls + auto + speed selectors -->
            <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-3">
                <div class="pl-field">
                    <span class="pl-field-label">Risk</span>
                    <div class="pl-segment">
                        @foreach (var risk in Risks)
                        {
                            <button class="pl-seg @(_risk == risk ? "pl-seg-on" : "")" disabled="@BoardLocked" @onclick="() => SetRisk(risk)">@RiskLabel(risk)</button>
                        }
                    </div>
                </div>
                <div class="pl-field">
                    <span class="pl-field-label">Rows</span>
                    <div class="pl-segment">
                        @foreach (var rows in RowPresets)
                        {
                            <button class="pl-seg @(_rows == rows ? "pl-seg-on" : "")" disabled="@BoardLocked" @onclick="() => SetRows(rows)">@rows</button>
                        }
                    </div>
                </div>
                <div class="pl-field">
                    <span class="pl-field-label">Balls</span>
                    <div class="pl-segment">
                        @foreach (var count in BallPresets)
                        {
                            <button class="pl-seg @(_balls == count ? "pl-seg-on" : "")" disabled="@_autoRunning" @onclick="() => SetBalls(count)">@count</button>
                        }
                    </div>
                </div>
                <div class="pl-field">
                    <span class="pl-field-label">Auto</span>
                    <div class="pl-segment">
                        @if (_autoRunning)
                        {
                            <button class="pl-seg pl-seg-stop" @onclick="StopAuto">
                                Stop@(_autoRemaining > 0 ? $" ({_autoRemaining})" : "")
                            </button>
                        }
                        else
                        {
                            @foreach (var n in AutoPresets)
                            {
                                <button class="pl-seg" disabled="@(!CanDrop)" @onclick="() => StartAuto(n)">@n</button>
                            }
                            <button class="pl-seg" disabled="@(!CanDrop)" @onclick="() => StartAuto(-1)">∞</button>
                        }
                    </div>
                </div>
                <div class="pl-field">
                    <span class="pl-field-label">Speed</span>
                    <div class="pl-segment">
                        <button class="pl-seg @(_turbo ? "pl-seg-on" : "")" @onclick="ToggleTurbo">
                            <i class="ph-fill ph-lightning"></i> Turbo
                        </button>
                    </div>
                </div>
            </div>

            <div class="mt-4">
                <BetControl @bind-Value="_bet" Balance="DisplayBalance" Min="MinBet" Max="MaxBet" Disabled="_autoRunning"/>
            </div>

            <div class="mt-4 flex flex-col items-center gap-2">
                @if (_autoRunning)
                {
                    <button class="pl-btn pl-btn-stop" @onclick="StopAuto">
                        <i class="ph-fill ph-stop-circle"></i>
                        <span>Stop auto@(_autoRemaining > 0 ? $" · {_autoRemaining} left" : "")</span>
                    </button>
                }
                else
                {
                    <button class="pl-btn pl-btn-drop" disabled="@(!CanDrop)" @onclick="Drop">
                        @if (_balls > 1)
                        {
                            <i class="ph-fill ph-circles-three"></i> <span>Drop @_balls balls · @TotalCost.ToString("N0")</span>
                        }
                        else
                        {
                            <i class="ph-fill ph-circle"></i> <span>Drop ball · @_bet.ToString("N0")</span>
                        }
                    </button>
                }
                @if (DisplayBalance < MinBet && _dropsInFlight == 0)
                {
                    <p class="text-sm text-rose-400">You need at least @MinBet.ToString("N0") credits to play.</p>
                }
                else if (TotalCost > DisplayBalance && _dropsInFlight == 0)
                {
                    <p class="text-sm text-rose-400">@_balls balls costs @TotalCost.ToString("N0") — more than your balance.</p>
                }
            </div>
        </div>

        <div class="mt-4 text-center">
            <a href="/credify" class="text-sm text-zinc-400 hover:text-zinc-200 hover:underline">← Back to Credify</a>
        </div>
    }
</PluginPageShell>
