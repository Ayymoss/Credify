@page "/credify"

<PageTitle>Credify</PageTitle>

<PluginPageShell BackgroundClass="credify-felt text-zinc-100" Menu='CredifyNav.Build("/credify")'>
    <div class="flex items-center justify-between">
        <h1 class="text-2xl font-bold">Credits</h1>
        <span class="credify-badge">economy</span>
    </div>

    <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3">
        <StatCard Title="Server bank" Value="@Cache.BankCredits.ToString("N0")"/>
        <StatCard Title="Ranked players" Value="@_board.Count.ToString("N0")"/>
        <StatCard Title="Top balance" Value="@_topBalance.ToString("N0")"/>
    </div>

    <h2 class="mt-7 flex items-center gap-2 text-lg font-bold">
        <i class="ph-fill ph-trophy text-amber-400"></i> Top Credits
    </h2>
    @if (_board.Count == 0)
    {
        <p class="mt-2 text-sm text-zinc-400">No credit data yet.</p>
    }
    else
    {
        <ol class="mt-3 space-y-1">
            @foreach (var (row, i) in _board.Select((r, i) => (r, i)))
            {
                <li class="flex items-center justify-between rounded-md bg-zinc-800/60 px-3 py-2 ring-1 ring-white/5">
                    <span class="flex items-center gap-2 truncate">
                        <span class="w-6 text-right font-semibold text-zinc-500">@(i + 1)</span>
                        <span class="truncate font-medium">@row.Name</span>
                    </span>
                    <span class="font-semibold text-[color:var(--color-action-primary,#818cf8)]">@row.Credits.ToString("N0")</span>
                </li>
            }
        </ol>
    }

    @* dev tool — money-sound tester; only rendered in DEBUG builds (gated by ShowDebugTools) *@
    @if (ShowDebugTools)
    {
        <MoneySoundTester/>
    }
</PluginPageShell>
