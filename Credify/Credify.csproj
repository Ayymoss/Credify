<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <!-- the only line needed to turn a plugin into a web bundle -->
        <IW4MAdminBundle>true</IW4MAdminBundle>
        <!-- opt in to the Tailwind helper (compiles Styles/tailwind.css into the bundle). Optional —
             remove this and compile CSS however you like; the bundle just packages wwwroot/. -->
        <IW4MAdminTailwind>true</IW4MAdminTailwind>
        <Authors>Amos</Authors>
        <Version>2026.06.09.2</Version>
    </PropertyGroup>

    <ItemGroup>
        <!-- WebCommon (PluginPageShell, SideContextMenu, Tooltip, …) now ships INSIDE this package as a
             bundled WebCommon.dll — the standalone RaidMax.IW4MAdmin.WebCommon package is deprecated.
             Sourced from the local feed (see ../nuget.config) until this version is published to nuget.org. -->
        <PackageReference Include="RaidMax.IW4MAdmin.SharedLibraryCore" Version="2026.6.10.4-preview"/>
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Chat\Active\Games\" />
      <Folder Include="Chat\Feature\" />
    </ItemGroup>

    <!-- TEMPORARY: until the SharedLibraryCore package ships the bundle targets, import them from the local
         IW4MAdmin checkout. Once published, referencing the package is enough — delete this line. -->
    <Import Project="..\..\..\_Cloned\IW4MAdmin\SharedLibraryCore\Packaging\RaidMax.IW4MAdmin.SharedLibraryCore.targets"
            Condition="Exists('..\..\..\_Cloned\IW4MAdmin\SharedLibraryCore\Packaging\RaidMax.IW4MAdmin.SharedLibraryCore.targets')" />

</Project>
