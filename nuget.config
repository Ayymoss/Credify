<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Local feed for the in-progress SharedLibraryCore (now bundles WebCommon.dll).
         Pack with: dotnet pack SharedLibraryCore.csproj -c Release -p:PackageVersion=<ver>-preview -o <this dir>
         Remove once the matching SLC version is published to nuget.org. -->
    <add key="local" value="localpackages" />
  </packageSources>
</configuration>
